  "frames": [
    {
      "id": "3:2",
      "code": "T00",
      "name": "T00 / Evidence to Action",
      "contentId": "3:7",
      "contentBottom": 574.2000045776367,
      "width": 612,
      "height": 792
    },
    {
      "id": "3:51",
      "code": "T01",
      "name": "T01 / One problem. A decision students can defend.",
      "contentId": "3:56",
      "contentBottom": 633.0000228881836,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:36",
      "code": "T02",
      "name": "T02 / Keep the human in the decision loop.",
      "contentId": "4:41",
      "contentBottom": 599.8000106811523,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:96",
      "code": "T03",
      "name": "T03 / Build one recommendation. Then solve a new case.",
      "contentId": "4:101",
      "contentBottom": 603.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:157",
      "code": "T04",
      "name": "T04 / Support independence without withholding access.",
      "contentId": "4:162",
      "contentBottom": 530.9999923706055,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:202",
      "code": "T05",
      "name": "T05 / Start with a human view. Then ask for useful help.",
      "contentId": "4:207",
      "contentBottom": 551.2000045776367,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:271",
      "code": "T06",
      "name": "T06 / AI can contribute. It cannot verify itself.",
      "contentId": "4:276",
      "contentBottom": 553.2000045776367,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:340",
      "code": "T07",
      "name": "T07 / Bring better evidence back. Make the final choice yourself.",
      "contentId": "4:345",
      "contentBottom": 592.1999740600586,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:409",
      "code": "T08",
      "name": "T08 / Use the routine again. Keep first work separate.",
      "contentId": "4:414",
      "contentBottom": 540.2000045776367,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:478",
      "code": "T09",
      "name": "T09 / Separate contribution from confirmation.",
      "contentId": "4:483",
      "contentBottom": 612.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:539",
      "code": "T10",
      "name": "T10 / An iteration needs a reason to change.",
      "contentId": "4:544",
      "contentBottom": 660.3999862670898,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:584",
      "code": "T11",
      "name": "T11 / Review the thinking trail, not just the final paragraph.",
      "contentId": "4:589",
      "contentBottom": 590.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:645",
      "code": "T12",
      "name": "T12 / Demonstrate a process. Keep the paper route complete.",
      "contentId": "4:650",
      "contentBottom": 523.3999862670898,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:690",
      "code": "T13",
      "name": "T13 / Take the routine to another real problem.",
      "contentId": "4:695",
      "contentBottom": 609.3999862670898,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:732",
      "code": "S00",
      "name": "S00 / Start with your own view.",
      "contentId": "4:737",
      "contentBottom": 685.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:761",
      "code": "S01",
      "name": "S01 / Solve the problem. Keep the decision yours.",
      "contentId": "4:766",
      "contentBottom": 633.0000228881836,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:809",
      "code": "S02",
      "name": "S02 / What do you think before receiving help?",
      "contentId": "4:814",
      "contentBottom": 687.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:838",
      "code": "S03",
      "name": "S03 / Inspect the original records.",
      "contentId": "4:843",
      "contentBottom": 505.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:861",
      "code": "S04",
      "name": "S04 / Direct the help without handing over judgment.",
      "contentId": "4:866",
      "contentBottom": 738.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:891",
      "code": "S05",
      "name": "S05 / Read the contribution before trusting it.",
      "contentId": "4:896",
      "contentBottom": 537.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:914",
      "code": "S06",
      "name": "S06 / What did AI contribute? What deserves a question?",
      "contentId": "4:919",
      "contentBottom": 738.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "4:944",
      "code": "S07",
      "name": "S07 / Check outside the reply.",
      "contentId": "4:949",
      "contentBottom": 706.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:386",
      "code": "S08",
      "name": "S08 / Consider people as well as performance.",
      "contentId": "5:391",
      "contentBottom": 537.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:409",
      "code": "S09",
      "name": "S09 / Return with better inputs.",
      "contentId": "5:414",
      "contentBottom": 655.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:438",
      "code": "S10",
      "name": "S10 / Better does not mean finished.",
      "contentId": "5:443",
      "contentBottom": 715.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:467",
      "code": "S11",
      "name": "S11 / Make the work yours.",
      "contentId": "5:472",
      "contentBottom": 596.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:493",
      "code": "S12",
      "name": "S12 / Use the routine in a different setting.",
      "contentId": "5:498",
      "contentBottom": 567.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:516",
      "code": "S13",
      "name": "S13 / Solve the new problem with your own reasoning.",
      "contentId": "5:521",
      "contentBottom": 600.5999984741211,
      "width": 612,
      "height": 792
    },
    {
      "id": "5:542",
      "code": "S14",
      "name": "S14 / Explain the improvement. Keep ownership of the answer.",
      "contentId": "5:547",
      "contentBottom": 687.5999984741211,
      "width": 612,
      "height": 792
    }
