<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content="Offline classroom slides for Evidence to Action: independent thinking, prepared AI exchanges, questioning, checking and revision."><link rel="canonical" href="https://vizancia.com/teachers/activity/"><title>Evidence to Action | Vizancia</title><style>
:root{color-scheme:light;--ink:#172238;--muted:#46566a;--purple:#5840c8;--paper:#f2f5f8}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:18px/1.55 system-ui,sans-serif}header,main,footer{max-width:1120px;margin:auto;padding:20px 28px}header{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.brand{font-weight:800;letter-spacing:.05em;margin-right:auto}button,a{font:inherit}button,.download{border:1px solid #c6ccda;border-radius:10px;padding:10px 16px;background:white;color:var(--ink);min-height:46px;cursor:pointer}button:hover{background:#e9e5ff}button:focus-visible,a:focus-visible{outline:3px solid #006b70;outline-offset:3px}button[aria-pressed=true],.primary{background:var(--purple);color:white}button:disabled{opacity:.45;cursor:default}nav{display:flex;flex-wrap:wrap;gap:8px}.eyebrow{color:var(--purple);font-size:.85rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}article{background:white;border-radius:20px;padding:clamp(22px,4vw,52px);margin:20px 0;box-shadow:0 4px 22px #17223809;border-top:5px solid var(--purple)}h1{font-size:clamp(1.5rem,3.3vw,2.5rem);line-height:1.15;letter-spacing:-.025em;margin:18px 0 24px}#body{font-size:clamp(1.05rem,2.1vw,1.55rem);white-space:pre-line;max-width:940px}.controls{display:flex;align-items:center;gap:14px;flex-wrap:wrap}.controls span{margin-right:auto}.notes{background:#edf5f3;border-left:4px solid #006b70;padding:18px 22px;white-space:pre-line}.small{font-size:.85rem;color:var(--muted)}.download{display:inline-block;color:var(--purple);text-decoration:none}footer{padding-top:0}body:fullscreen{overflow:auto}@media(max-width:520px){header,main,footer{padding:16px}header .small{display:none}article{margin:16px 0}.controls span{width:100%}}@media print{header,nav,.controls,footer,#notes{display:none!important}body{background:white}article{box-shadow:none;border:0;padding:10px}h1{font-size:24pt}#body{font-size:16pt}}
</style></head><body><a href="#main-content">Skip to activity</a><header><div class="brand">VIZANCIA <span class="small">/ Evidence to Action</span></div><button id="fullscreen">Full screen</button><a class="download" href="evidence-to-action-complete.pdf">Complete packet (PDF)</a></header><main id="main-content"><p class="small">Teacher-led pilot · Grades 6-8 · Four planned 45-minute sessions plus a separate baseline. Prepared AI exchanges and paper responses; no student account or live AI is required.</p><nav aria-label="Choose session"></nav><article aria-live="polite" aria-atomic="true"><p class="eyebrow" id="context"></p><h1 id="title" tabindex="-1"></h1><div id="body"></div></article><div class="controls"><span id="position" class="small"></span><button id="prev">Previous</button><button id="next" class="primary">Next</button><button id="toggleNotes" aria-expanded="false" aria-controls="notes">Show facilitator notes</button></div><aside id="notes" class="notes" hidden></aside></main><footer><p><a href="../">Teacher guide</a> · <a href="../../privacy.html">Privacy</a></p><p class="small">Fictional people, organisations, data and authored AI-style replies. No live AI. This projection view takes no student input, saves no progress, and loads no third-party scripts. When opened online, the website host processes the page request; save this page to use it offline. Use the packet for individual responses; do not project private Passport entries.</p><p class="small">Keyboard: left/right arrows change slides. Facilitator notes contain discussion guidance; reveal them after students give reasons. Classroom studio 2 · October 2026. First attempts precede feedback; keep worked examples and transfer keys hidden until then.</p></footer><script>
const slides=__SLIDES__;let index=0;const $=id=>document.getElementById(id);const nav=document.querySelector('nav');
[1,2,3,4].forEach(n=>{const b=document.createElement('button');b.textContent='Session '+n;b.dataset.session=n;b.addEventListener('click',()=>{index=slides.findIndex(s=>s.session===n);render()});nav.appendChild(b)});
function render(){const s=slides[index];$('context').textContent='Session '+s.session+' / '+s.kind;$('title').textContent=s.title;$('body').textContent=s.body;$('position').textContent='Slide '+(index+1)+' of '+slides.length;$('prev').disabled=index===0;$('next').disabled=index===slides.length-1;$('notes').hidden=true;$('notes').textContent=s.notes;$('toggleNotes').hidden=!s.notes;$('toggleNotes').textContent='Show facilitator notes';$('toggleNotes').setAttribute('aria-expanded','false');nav.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.session)===s.session)));history.replaceState(null,'','#'+(index+1));window.scrollTo(0,0)}
function move(d){const next=Math.max(0,Math.min(slides.length-1,index+d));if(next!==index){index=next;render()}}
$('prev').onclick=()=>move(-1);$('next').onclick=()=>move(1);$('toggleNotes').onclick=()=>{const hidden=!$('notes').hidden;$('notes').hidden=hidden;$('toggleNotes').textContent=hidden?'Show facilitator notes':'Hide facilitator notes';$('toggleNotes').setAttribute('aria-expanded',String(!hidden))};$('fullscreen').onclick=async()=>{try{if(document.fullscreenElement){await document.exitFullscreen()}else{await document.documentElement.requestFullscreen()}}catch{ $('fullscreen').textContent='Use browser full screen'}};
document.addEventListener('keydown',e=>{if(e.altKey||e.ctrlKey||e.metaKey)return;if(e.key==='ArrowRight'){e.preventDefault();move(1)}if(e.key==='ArrowLeft'){e.preventDefault();move(-1)}});const requested=Number(location.hash.slice(1));if(Number.isInteger(requested)&&requested>=1&&requested<=slides.length)index=requested-1;render();
</script></body></html>